{
  "name": "cryptgrid",
  "private": true,
  "version": "0.0.0",
  "description": "Cryptgrid: Vault of Shadows — first-person real-time grid dungeon crawler",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm --filter @cryptgrid/game dev",
    "dev:editor": "pnpm --filter @cryptgrid/editor dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "build": "pnpm -r build",
    "smoke": "pnpm --filter @cryptgrid/game test:e2e",
    "gen:textures": "node tools/gen-textures/generate.mjs",
    "gen:items": "node tools/gen-items/generate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^26.1.2",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.32.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
